# Copy to /etc/xray-dashboard.env and replace the placeholders.
# Keep the real file owned by root with mode 0600. Never commit it.
DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_OPENSSL_RAND_HEX_32
XRAY_LOG_DIR=/var/log/x-ui
XRAY_DASHBOARD_DB=/var/lib/xray-dashboard/history.sqlite3
